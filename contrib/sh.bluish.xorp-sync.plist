<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: run 'xorp sync' every 3 minutes. Replace USER, then:
     cp contrib/sh.bluish.xorp-sync.plist ~/Library/LaunchAgents/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sh.bluish.xorp-sync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>sh.bluish.xorp-sync</string>
  <key>ProgramArguments</key>
  <array><string>/Users/USER/.local/bin/xorp</string><string>sync</string></array>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
